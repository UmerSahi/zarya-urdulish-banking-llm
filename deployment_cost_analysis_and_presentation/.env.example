# Zarya Digital Bank AI Support Gateway — Environment Configuration
# Regulatory Compliance: State Bank of Pakistan (SBP) Framework

# Application Settings
APP_ENV=production
DEBUG=false
PORT=8000
STREAMLIT_PORT=8501
ZARYA_API_URL=http://127.0.0.1:8000

# Base Model & LoRA Adapter Configuration
BASE_MODEL_NAME=unsloth/Qwen2.5-3B-Instruct-unsloth-bnb-4bit
ADAPTER_PATH=Adaptors/qwen-adaptors
QUANTIZATION_FORMAT=GGUF_Q4_K_M
DEVICE_TARGET=cuda

# Hugging Face Repository & Secrets
HF_MODEL_REPO_ID=zarya-digital-bank/qwen-2.5-3b-urdulish-banking-dpo
HF_TOKEN=hf_your_production_secret_token_here

# SBP Banking Guardrails & Security Interceptors
SBP_STRICT_OTP_BLOCK=true
SBP_FRAUD_INTERCEPTOR_ACTIVE=true
PII_LOG_MASKING=true

# Database Persistence
DATABASE_URL=sqlite:///./deployment_cost_analysis_and_presentation/data/zarya_production.db
POSTGRES_FALLBACK_URL=postgresql://zarya_user:secure_pass@localhost:5432/zarya_db

# Telemetry & Experiment Tracking
LOG_LEVEL=INFO
ENABLE_TELEMETRY=true
DPO_COLLECTION_ACTIVE=true

